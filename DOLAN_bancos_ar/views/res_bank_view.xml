<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_dolan_banco_ar_tree" model="ir.ui.view">
    <field name="name">dolan.banco.ar.tree</field>
    <field name="model">dolan.banco.ar</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="code"/>
        <field name="name"/>
        <field name="city"/>
        <field name="active" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_dolan_banco_ar_form" model="ir.ui.view">
    <field name="name">dolan.banco.ar.form</field>
    <field name="model">dolan.banco.ar</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="code"/>
            <field name="name"/>
            <field name="city"/>
            <field name="country_id" groups="base.group_multi_company"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_dolan_banco_ar" model="ir.actions.act_window">
    <field name="name">Bancos (AR)</field>
    <field name="res_model">dolan.banco.ar</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_dolan_banco_ar" name="Bancos (AR)" sequence="45"
            parent="account.menu_finance_configuration" action="action_dolan_banco_ar"
            groups="account.group_account_readonly"/>
</odoo>
