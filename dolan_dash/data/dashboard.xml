<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Listados (operaciones) ============ -->
    <record id="act_compras_pendientes" model="ir.actions.act_window">
        <field name="name">Compras - por pagar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[("state", "=", "posted"), ("move_type", "=", "in_invoice"), ("payment_state", "not in", ("paid", "reversed"))]</field>
        <field name="context">{"order": "invoice_date desc"}</field>
    </record>
    <record id="act_compras_pagadas" model="ir.actions.act_window">
        <field name="name">Compras - pagadas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[("state", "=", "posted"), ("move_type", "=", "in_invoice"), ("payment_state", "in", ("paid", "reversed"))]</field>
        <field name="context">{"order": "invoice_date desc"}</field>
    </record>
    <record id="act_facturas" model="ir.actions.act_window">
        <field name="name">Facturas de venta</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[("state", "=", "posted"), ("move_type", "in", ("out_invoice", "out_refund"))]</field>
        <field name="context">{"order": "invoice_date desc"}</field>
    </record>
    <record id="act_nc" model="ir.actions.act_window">
        <field name="name">Notas de credito</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[("state", "=", "posted"), ("move_type", "=", "out_refund")]</field>
        <field name="context">{"order": "invoice_date desc"}</field>
    </record>
    <record id="act_remitos" model="ir.actions.act_window">
        <field name="name">Remitos entregados</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[("state", "=", "done")]</field>
        <field name="context">{"order": "scheduled_date desc"}</field>
    </record>
    <record id="act_compras" model="ir.actions.act_window">
        <field name="name">Comprobantes de compra (por pagar)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[("state", "=", "posted"), ("move_type", "=", "in_invoice")]</field>
        <field name="context">{"order": "invoice_date desc"}</field>
    </record>

    <!-- Tablero de LISTADOS (board nativo: paneles con listas embebidas) -->
    <record id="view_operaciones_board" model="ir.ui.view">
        <field name="name">dolan_dash.operaciones.board</field>
        <field name="model">board.board</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form string="Operaciones">
                <board style="1-1">
                    <column>
                        <action name="%(dolan_dash.act_compras_pendientes)d" string="Compras - por pagar" type="action"/>
                        <action name="%(dolan_dash.act_compras_pagadas)d" string="Compras - pagadas" type="action"/>
                        <action name="%(dolan_dash.act_compras)d" string="Todas las compras" type="action"/>
                    </column>
                    <column>
                        <action name="%(dolan_dash.act_facturas)d" string="Facturas de venta" type="action"/>
                        <action name="%(dolan_dash.act_nc)d" string="Notas de credito" type="action"/>
                        <action name="%(dolan_dash.act_remitos)d" string="Remitos" type="action"/>
                    </column>
                </board>
            </form>
        </field>
    </record>

    <record id="action_operaciones_board" model="ir.actions.act_window">
        <field name="name">Operaciones</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_operaciones_root" name="Operaciones" sequence="5"
              web_icon="dolan_dash,static/description/icon.svg"
              groups="base.group_user"/>
    <menuitem id="menu_operaciones_board" name="Tablero" parent="menu_operaciones_root"
              action="action_operaciones_board" sequence="1" groups="base.group_user"/>
</odoo>
