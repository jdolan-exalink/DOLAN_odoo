<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Badge de estado de pago en la lista generica de asientos/facturas
         (mismo widget + decoraciones que usa el core en account.invoice.list) -->
    <record id="view_move_tree_dolan_badge" model="ir.ui.view">
        <field name="name">account.move.list.dolan.badge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="status_in_payment" string="Estado" widget="badge"
                       decoration-info="status_in_payment == 'draft'"
                       decoration-danger="status_in_payment in ('blocked', 'cancel')"
                       decoration-muted="status_in_payment in ('posted', 'sent', 'partial')"
                       decoration-success="status_in_payment in ('in_payment', 'paid', 'reversed')"
                       invisible="payment_state == 'invoicing_legacy' or move_type == 'entry'"
                       optional="show"/>
                <field name="dolan_last_reconcile" string="Último recobro" optional="show"/>
            </xpath>
        </field>
    </record>

  <!-- Lista de facturas (primary account.invoice.list y sus hijas: out/in lists) -->
  <record id="view_invoice_list_dolan_recobro" model="ir.ui.view">
    <field name="name">account.invoice.list.dolan.recobro</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_invoice_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="inside">
        <field name="dolan_last_reconcile" string="Último recobro" optional="show"/>
      </xpath>
    </field>
  </record>

  <!-- Entradas OCR: menú "Escanear compra (IA)" bajo Facturación y Compras -->
  <record id="action_dolan_ocr" model="ir.actions.act_url">
    <field name="name">Escanear compra (IA)</field>
    <field name="url">/dolan_ai#ocr</field>
    <field name="target">self</field>
  </record>
  <record id="menu_dolan_ocr_facturas" model="ir.ui.menu">
    <field name="name">Escanear compra (IA)</field>
    <field name="parent_id" ref="account.menu_finance"/>
    <field name="action" ref="action_dolan_ocr"/>
    <field name="sequence">8</field>
  </record>
  <record id="menu_dolan_ocr_compras" model="ir.ui.menu">
    <field name="name">Escanear compra (IA)</field>
    <field name="parent_id" ref="purchase.menu_purchase_root"/>
    <field name="action" ref="action_dolan_ocr"/>
    <field name="sequence">8</field>
  </record>
</odoo>
