<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_dolan_alquiler_list" model="ir.ui.view">
    <field name="name">dolan.alquiler.contrato.list</field>
    <field name="model">dolan.alquiler.contrato</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="product_id"/>
        <field name="fecha_inicio"/>
        <field name="fecha_fin"/>
        <field name="dias" sum="Total días"/>
        <field name="tarifa_dia"/>
              <field name="fecha_pickup"/>
              <field name="fecha_return"/>
              <field name="estado_ops"/>
        <field name="total" sum="Total"/>
        <field name="fecha_pickup" optional="show"/>
        <field name="fecha_return" optional="show"/>
        <field name="estado_ops" widget="badge" decoration-warning="estado_ops=='pendiente'" decoration-info="estado_ops=='recolectada'" decoration-success="estado_ops=='devuelta'"/>
        <field name="estado_factura" widget="badge" optional="show"/>
        <field name="state" widget="badge" decoration-success="state=='activo'" decoration-info="state=='borrador'" decoration-muted="state in ('finalizado','cancelado')"/>
        <field name="move_id" optional="show"/>
      </list>
    </field>
  </record>
  <record id="view_dolan_alquiler_form" model="ir.ui.view">
    <field name="name">dolan.alquiler.contrato.form</field>
    <field name="model">dolan.alquiler.contrato</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_iniciar" type="object" string="Iniciar" class="btn-primary" invisible="state != 'borrador'"/>
          <button name="action_finalizar" type="object" string="Finalizar" invisible="state != 'activo'"/>
          <button name="action_cancelar" type="object" string="Cancelar" invisible="state in ('finalizado','cancelado')"/>
          <button name="action_facturar" type="object" string="Facturar" class="btn-primary" invisible="move_id or state in ('cancelado','finalizado')"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="partner_id"/>
              <field name="product_id"/>
            </group>
            <group>
              <field name="fecha_inicio"/>
              <field name="fecha_fin"/>
              <field name="tarifa_dia"/>
              <field name="fecha_pickup"/>
              <field name="fecha_return"/>
              <field name="estado_ops"/>
              <field name="dias"/>
              <field name="total"/>
            </group>
          </group>
          <group invisible="not move_id">
            <field name="move_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_alquiler_calendar" model="ir.ui.view">
    <field name="name">dolan.alquiler.contrato.calendar</field>
    <field name="model">dolan.alquiler.contrato</field>
    <field name="arch" type="xml">
      <calendar date_start="fecha_inicio" date_stop="fecha_fin" mode="month" event_limit="4">
        <field name="partner_id"/>
        <field name="product_id"/>
        <field name="total"/>
        <field name="estado_ops"/>
      </calendar>
    </field>
  </record>
  <record id="action_dolan_alquiler" model="ir.actions.act_window">
    <field name="name">Contratos de alquiler</field>
    <field name="res_model">dolan.alquiler.contrato</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="menu_dolan_alquiler_root" model="ir.ui.menu">
    <field name="name">Alquileres</field>
    <field name="web_icon">DOLAN_alquileres,static/description/icon.png</field>
    <field name="sequence">52</field>
  </record>
  <record id="menu_dolan_alquileres" model="ir.ui.menu">
    <field name="name">Contratos</field>
    <field name="parent_id" ref="menu_dolan_alquiler_root"/>
    <field name="action" ref="action_dolan_alquiler"/>
    <field name="sequence">10</field>
  </record>
  <record id="action_dolan_alquiler_tablero" model="ir.actions.act_url">
    <field name="name">Tablero DOLAN</field>
    <field name="url">/dolan_alquileres</field>
    <field name="target">self</field>
  </record>
  <record id="menu_dolan_alquiler_tablero" model="ir.ui.menu">
    <field name="name">Tablero</field>
    <field name="parent_id" ref="menu_dolan_alquiler_root"/>
    <field name="action" ref="action_dolan_alquiler_tablero"/>
    <field name="sequence">5</field>
  </record>
</odoo>
