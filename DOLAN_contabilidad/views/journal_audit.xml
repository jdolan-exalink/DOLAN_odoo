<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- S8/C11 · Auditoría de diario propia (LGPL, sin OCA), modelada en el
         reporte homónimo de Enterprise (Documentos | Por revisar | Deber |
         Haber | Balance) + controles de secuencia y borradores. -->

    <record id="view_dolan_journal_audit_form" model="ir.ui.view">
        <field name="name">dolan.journal.audit.form</field>
        <field name="model">dolan.journal.audit</field>
        <field name="arch" type="xml">
            <form string="Auditoría de diario">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="journal_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generar XLSX" type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_journal_audit_xlsx" model="ir.actions.report">
        <field name="name">Auditoría de diario DOLAN</field>
        <field name="model">dolan.journal.audit</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">dolan_contabilidad.journal_audit</field>
    </record>

    <record id="action_dolan_journal_audit" model="ir.actions.act_window">
        <field name="name">Auditoría de diario</field>
        <field name="res_model">dolan.journal.audit</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="menu_dolan_journal_audit" model="ir.ui.menu">
        <field name="name" eval="{'en_US': 'Journal Audit', 'es_AR': 'Auditoría de diario'}"/>
        <field name="parent_id" ref="account.account_audit_control_menu"/>
        <field name="action" ref="action_dolan_journal_audit"/>
        <field name="sequence">40</field>
    </record>
</odoo>
