<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_l10n_latam_check_form_reject" model="ir.ui.view">
    <field name="name">l10n.latam.check.form.reject</field>
    <field name="model">l10n_latam.check</field>
    <field name="inherit_id" ref="l10n_latam_check.l10n_latam_check_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_mark_rejected" string="Marcar rechazado" type="object"
                class="btn btn-secondary" invisible="dolan_rejected"
                groups="account.group_account_readonly"/>
        <button name="action_clear_rejected" string="Quitar rechazo" type="object"
                class="btn btn-secondary" invisible="not dolan_rejected"
                groups="account.group_account_readonly"/>
      </xpath>
      <xpath expr="//sheet" position="inside">
        <group string="Rechazo" invisible="not dolan_rejected">
          <field name="dolan_rejected" invisible="1"/>
          <field name="dolan_rejected_date"/>
          <field name="dolan_rejected_reason"/>
        </group>
        <field name="dolan_rejected" invisible="1"/>
      </xpath>
    </field>
  </record>

  <record id="view_account_third_party_check_tree_reject" model="ir.ui.view">
    <field name="name">l10n.latam.check.list.reject</field>
    <field name="model">l10n_latam.check</field>
    <field name="inherit_id" ref="l10n_latam_check.view_account_third_party_check_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="dolan_rejected" optional="show"/>
      </xpath>
    </field>
  </record>
</odoo>
