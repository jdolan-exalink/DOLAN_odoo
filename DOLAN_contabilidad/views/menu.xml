<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_dolan_contabilidad" model="ir.actions.act_url">
    <field name="name">Tablero DOLAN</field>
    <field name="url">/dolan_contabilidad</field>
    <field name="target">self</field>
  </record>
  <record id="menu_dolan_contabilidad" model="ir.ui.menu">
    <field name="name">Tablero DOLAN</field>
    <field name="parent_id" ref="account.menu_finance"/>
    <field name="action" ref="action_dolan_contabilidad"/>
    <field name="sequence">5</field>
  </record>

  <!-- S8/P1 — paridad con la app "Contabilidad" de la demo EE (see
       docs/ee-parity-contabilidad.md, C1-C2).
       1) La app contable pasa a llamarse Contabilidad en todos los idiomas
          (el nombre "Facturación" venía de la traducción CE de Invoicing).
       2) En CE, el rol "Administrator" de contabilidad (group_account_manager)
          NO implicaba "Show Full Accounting Features", por lo que al admin no
          le aparecían las secciones Contabilidad / Revisión / Reportes.
          Se le agrega la implicación para que un administrador contable vea
          exactamente lo que ve la demo. -->
  <record id="account.menu_finance" model="ir.ui.menu">
    <field name="name" eval="{'en_US': 'Contabilidad', 'es_AR': 'Contabilidad'}"/>
  </record>

  <record id="account.group_account_manager" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
  </record>

  <!-- S8/P2 — menús equivalentes a la demo (C6 estados de cuenta, C13 consulta ARCA).
       Las acciones ya existen en CE/OCA instaladas; sólo se exponen en la misma
       estructura que la demo (Reportes > Reportes del contacto; Contabilidad >
       Consultar factura en ARCA). -->
  <record id="menu_reports_contact" model="ir.ui.menu">
    <field name="name" eval="{'en_US': 'Contact Reports', 'es_AR': 'Reportes del contacto'}"/>
    <field name="parent_id" ref="account.menu_finance_reports"/>
    <field name="sequence">25</field>
  </record>

  <record id="menu_statement_activity" model="ir.ui.menu">
    <field name="name" eval="{'en_US': 'Customer Account Statement', 'es_AR': 'Estado de la cuenta del cliente'}"/>
    <field name="parent_id" ref="menu_reports_contact"/>
    <field name="action" ref="partner_statement.activity_statement_wizard_action"/>
    <field name="sequence">10</field>
  </record>

  <record id="menu_statement_outstanding" model="ir.ui.menu">
    <field name="name" eval="{'en_US': 'Customer Outstanding Statement', 'es_AR': 'Estado de los pendientes de la cuenta'}"/>
    <field name="parent_id" ref="menu_reports_contact"/>
    <field name="action" ref="partner_statement.outstanding_statement_wizard_action"/>
    <field name="sequence">20</field>
  </record>

  <record id="menu_statement_detailed" model="ir.ui.menu">
    <field name="name" eval="{'en_US': 'Detailed Partner Activity', 'es_AR': 'Actividad detallada del contacto'}"/>
    <field name="parent_id" ref="menu_reports_contact"/>
    <field name="action" ref="partner_statement.detailed_activity_statement_wizard_action"/>
    <field name="sequence">30</field>
  </record>

  <record id="menu_arca_recover" model="ir.ui.menu">
    <field name="name" eval="{'en_US': 'Query invoice in ARCA', 'es_AR': 'Consultar factura en ARCA'}"/>
    <field name="parent_id" ref="account.menu_finance_entries"/>
    <field name="action" ref="l10n_ar_fiscal_ws.action_fiscal_ws_recover"/>
    <field name="sequence">90</field>
  </record>

  <!-- S8/P2 · Resumen IVA (C7): el módulo l10n_ar_fiscal_ws_reports ya trae
       Libro de IVA ventas/compras y el cubo de análisis; se les ponen los
       nombres en español como en la demo (Reportes > Informes Argentinos). -->
  <record id="l10n_ar_fiscal_ws_reports.menu_account_sale_vat_ledger" model="ir.ui.menu">
    <field name="name" eval="{'en_US': 'Sales VAT Ledger', 'es_AR': 'Libro de IVA - Ventas'}"/>
    <field name="sequence">10</field>
  </record>

  <record id="l10n_ar_fiscal_ws_reports.menu_account_purchase_vat_ledger" model="ir.ui.menu">
    <field name="name" eval="{'en_US': 'Purchases VAT Ledger', 'es_AR': 'Libro de IVA - Compras'}"/>
    <field name="sequence">20</field>
  </record>

  <record id="l10n_ar_fiscal_ws_reports.menu_current_account" model="ir.ui.menu">
    <field name="name" eval="{'en_US': 'VAT Analysis', 'es_AR': 'Análisis de IVA'}"/>
    <field name="sequence">30</field>
  </record>
</odoo>
