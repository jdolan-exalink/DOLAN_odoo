<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_dolan_annual_report_form" model="ir.ui.view">
    <field name="name">dolan.annual.report.form</field>
    <field name="model">dolan.annual.report</field>
    <field name="arch" type="xml">
      <form string="Reporte anual">
        <group>
          <field name="date_from"/>
          <field name="date_to"/>
        </group>
        <footer>
          <button name="action_generate" string="Generar XLSX" type="object" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_annual_report_xlsx" model="ir.actions.report">
    <field name="name">Reporte anual DOLAN</field>
    <field name="model">dolan.annual.report</field>
    <field name="report_type">xlsx</field>
    <field name="report_name">dolan_contabilidad.annual_report</field>
  </record>

  <record id="action_dolan_annual_report" model="ir.actions.act_window">
    <field name="name">Reporte anual</field>
    <field name="res_model">dolan.annual.report</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <record id="menu_audit_annual_report" model="ir.ui.menu">
    <field name="name" eval="{'en_US': 'Annual Report', 'es_AR': 'Reporte anual'}"/>
    <field name="parent_id" ref="menu_audit_workpapers"/>
    <field name="action" ref="action_dolan_annual_report"/>
    <field name="sequence">20</field>
  </record>
</odoo>
