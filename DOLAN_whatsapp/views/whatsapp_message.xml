<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_dolan_whatsapp_message_form" model="ir.ui.view">
    <field name="name">dolan.whatsapp.message.form</field>
    <field name="model">dolan.whatsapp.message</field>
    <field name="arch" type="xml">
      <form string="WhatsApp">
        <header>
          <field name="status" widget="statusbar" statusbar_visible="sent,received,error"/>
          <button name="action_send" string="Enviar" type="object" class="btn-primary"
                  invisible="direction != 'out' or status in ('sent', 'received')"/>
        </header>
        <group>
          <field name="direction"/>
          <field name="partner_id"/>
          <field name="chat_id"/>
          <field name="external_id" invisible="not external_id"/>
          <field name="error" invisible="not error"/>
        </group>
        <group>
          <field name="body" nolabel="1" placeholder="Mensaje de WhatsApp..."/>
        </group>
      </form>
    </field>
  </record>

  <record id="view_dolan_whatsapp_message_tree" model="ir.ui.view">
    <field name="name">dolan.whatsapp.message.tree</field>
    <field name="model">dolan.whatsapp.message</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="create_date"/>
        <field name="direction"/>
        <field name="partner_id"/>
        <field name="body"/>
        <field name="status"/>
      </list>
    </field>
  </record>

  <record id="action_dolan_whatsapp_message" model="ir.actions.act_window">
    <field name="name">WhatsApp (WAHA)</field>
    <field name="res_model">dolan.whatsapp.message</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_dolan_whatsapp" name="WhatsApp (WAHA)" sequence="30"
            parent="base.menu_administration" action="action_dolan_whatsapp_message"
            groups="base.group_system"/>
</odoo>
