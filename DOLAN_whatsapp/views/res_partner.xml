<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_partner_form_whatsapp" model="ir.ui.view">
    <field name="name">res.partner.form.whatsapp</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="after">
        <button name="action_send_whatsapp" string="WhatsApp" type="object"
                class="btn btn-primary" groups="base.group_user"/>
      </xpath>
    </field>
  </record>
</odoo>
