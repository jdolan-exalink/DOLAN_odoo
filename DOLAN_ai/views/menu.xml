<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- App DOLAN AI: raíz con icono (grid + rail) y acción derivada del hijo -->
  <record id="menu_dolan_ai_root" model="ir.ui.menu">
    <field name="name">DOLAN AI</field>
    <field name="web_icon">DOLAN_ai,static/description/icon.png</field>
    <field name="sequence">45</field>
  </record>
  <record id="action_dolan_ai_page" model="ir.actions.act_url">
    <field name="name">DOLAN AI</field>
    <field name="url">/dolan_ai</field>
    <field name="target">self</field>
  </record>
  <record id="menu_dolan_ai" model="ir.ui.menu">
    <field name="name">ChatGPT</field>
    <field name="parent_id" ref="menu_dolan_ai_root"/>
    <field name="action" ref="action_dolan_ai_page"/>
    <field name="sequence">10</field>
  </record>
</odoo>
