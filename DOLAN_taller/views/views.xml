<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_turno_list" model="ir.ui.view">
    <field name="name">dolan.taller.turno.list</field>
    <field name="model">dolan.taller.turno</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="workcenter_id"/>
        <field name="workorder_id" optional="show"/>
        <field name="operador_id" widget="many2one_avatar_user"/>
        <field name="inicio"/>
        <field name="minutos" sum="Minutos"/>
        <field name="state" widget="badge" decoration-success="state=='corriendo'" decoration-warning="state=='pausado'" decoration-muted="state=='terminado'"/>
      </list>
    </field>
  </record>
  <record id="view_turno_form" model="ir.ui.view">
    <field name="name">dolan.taller.turno.form</field>
    <field name="model">dolan.taller.turno</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_pausar" type="object" string="Pausar" class="btn-primary" invisible="state != 'corriendo'"/>
          <button name="action_reanudar" type="object" string="Reanudar" invisible="state != 'pausado'"/>
          <button name="action_terminar" type="object" string="Terminar" invisible="state == 'terminado'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="workcenter_id"/>
              <field name="workorder_id"/>
              <field name="production_id" invisible="1"/>
            </group>
            <group>
              <field name="operador_id"/>
              <field name="inicio"/>
              <field name="fin"/>
              <field name="minutos"/>
            </group>
          </group>
          <notebook>
            <page string="Materiales" name="materiales">
              <field name="consumo_ids">
                <list editable="bottom">
                  <field name="product_id"/>
                  <field name="cantidad"/>
                  <field name="uom_id"/>
                </list>
              </field>
            </page>
            <page string="Control de calidad" name="qc">
              <field name="qc_ids">
                <list>
                  <field name="name"/>
                  <field name="punto_id"/>
                  <field name="resultado" widget="badge" decoration-success="resultado=='ok'" decoration-danger="resultado=='ko'"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="activity_ids"/>
          <field name="message_ids"/>
        </div>
      </form>
    </field>
  </record>
  <record id="action_turno" model="ir.actions.act_window">
    <field name="name">Turnos</field>
    <field name="res_model">dolan.taller.turno</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
