<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
  <!-- Rail izquierdo de apps (desktop) — extension OFICIAL del template core
       web.NavBar.AppsMenu (mismo scope: reutiliza apps + handlers del core). -->
  <t t-name="DOLAN_theme.NavBar.Rail" t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_navbar_apps_menu')]" position="before">
      <div class="o_dolan_rail d-none d-lg-flex">
        <div class="o_dolan_rail_head">
          <span class="o_dolan_rail_title">Aplicaciones</span>
          <button type="button" class="o_dolan_rail_toggle" data-dolan-rail-toggle=""
                  title="Compactar / expandir la barra">
            <span class="tg-close">«</span><span class="tg-open">»</span>
          </button>
        </div>
        <t t-foreach="apps" t-as="app" t-key="app.id">
          <a class="o_dolan_rail_item"
             t-att-class="{'o_dolan_rail_active': this.menuService.getCurrentApp() === app}"
             t-att-href="this.getMenuItemHref(app)"
             t-att-data-menu-xmlid="app.xmlid"
             t-on-click.prevent="() => { this.onNavBarDropdownItemSelection(app); }">
            <img class="o_dolan_rail_icon" t-if="app.webIconData" t-attf-src="{{ app.webIconData }}"/>
            <i t-elif="app.webIcon" class="oi o_dolan_rail_ico" t-att-data-icon="app.webIcon.split(',')[0]"/>
            <span class="o_dolan_rail_label" t-out="app.name"/>
          </a>
        </t>
      </div>
    </xpath>
  </t>
</templates>
